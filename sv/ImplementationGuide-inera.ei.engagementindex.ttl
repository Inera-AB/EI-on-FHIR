       fhir:description [ fhir:v "En post som har tagits bort ur EI. Den visas med status superseded under borttagsloggens lagringstid, så att synken till eHM:s patientindex ser borttaget." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraEngagement"^^xsd:anyURI ;
