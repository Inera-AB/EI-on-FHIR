         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CapabilityStatement/IneraEngagementIndexServer> ;
         fhir:reference [ fhir:v "CapabilityStatement/IneraEngagementIndexServer" ]
       ] ;
       fhir:name [ fhir:v "EI-on-FHIR server" ] ;
       fhir:description [ fhir:v "Krav på EI-on-FHIR som server: läsning och sökning av engagemangsposter från EI och från EI-on-FHIR:s register, registrering i registret för FHIR-producenter. Massuttag med Bulk Data $export krävs i text på IG-sidan API, eftersom Bulk Data Access bara finns för R4." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraEngagement> ;
         fhir:reference [ fhir:v "StructureDefinition/IneraEngagement" ]
       ] ;
       fhir:name [ fhir:v "Engagemangspost" ] ;
       fhir:description [ fhir:v "En engagemangspost, exponerad som DocumentReference. Posten pekar ut att ett källsystem har information om en patient inom en tjänstedomän, och hur den hämtas: med RIV-TA via tjänsteplattformen och en logisk adress, eller med FHIR från en endpoint. Den bär inget journalinnehåll. Posten kommer antingen från engagemangsindex (EI) eller från EI-on-FHIR:s eget register för FHIR-producenter. En resurs motsvarar en post, utan sammanslagning." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "DocumentReference"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/DocumentReference/EngagemangspostFhir> ;
         fhir:reference [ fhir:v "DocumentReference/EngagemangspostFhir" ]
       ] ;
       fhir:name [ fhir:v "Engagemangspost från en FHIR-producent" ] ;
       fhir:description [ fhir:v "En post i EI-on-FHIR:s register. Källsystemet SE0000000000-SYS1 svarar både på tjänstekontraktet och på tjänstens FHIR-IG, och har därför också en RIV-TA-post i EI (Aktuell engagemangspost). Posterna har samma patient, tjänstedomän och logiska adress, så en konsument kan välja väg." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraEngagement"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraEngagement>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "DocumentReference"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/DocumentReference/EngagemangspostKallsystemSomPuA> ;
         fhir:reference [ fhir:v "DocumentReference/EngagemangspostKallsystemSomPuA" ]
       ] ;
       fhir:name [ fhir:v "Engagemangspost med källsystemet som personuppgiftsansvarig" ] ;
       fhir:description [ fhir:v "En engagemangspost där dataController är källsystemets HSA-id, som EI har godtagit sedan migreringen från NPÖ:s index. Vårdgivaren går inte att läsa ut ur custodian." ] ;
