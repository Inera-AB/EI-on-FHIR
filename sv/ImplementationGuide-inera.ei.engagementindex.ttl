       fhir:name [ fhir:v "Aktuell engagemangspost" ] ;
       fhir:description [ fhir:v "En engagemangspost i tjänstedomänen riv:clinicalprocess:healthcond:description, där vårdgivarens HSA-id är både logisk adress och personuppgiftsansvarig." ] ;
