         fhir:value [
           a fhir:string ;
           fhir:v "CapabilityStatement"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CapabilityStatement/IneraIndexServer> ;
         fhir:reference [ fhir:v "CapabilityStatement/IneraIndexServer" ]
       ] ;
       fhir:name [ fhir:v "FHIR-EI server" ] ;
       fhir:description [ fhir:v "Krav på FHIR-EI som server: sökning, registrering och avregistrering, prenumeration, inkrementell avstämning och massuttag av indexposter." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry> ;
         fhir:reference [ fhir:v "StructureDefinition/IneraIndexEntry" ]
       ] ;
       fhir:name [ fhir:v "Indexpost (FHIR-EI)" ] ;
       fhir:description [ fhir:v "Gemensam indexpost. Anger att en producent via en endpoint har information om en patient inom en tjänst.\nDet finns en post per patient × endpoint × tjänst. Posten kan bära flera informationsmängder, och tidpunkten\nför senaste ändring av innehållet gäller hela posten.\n\nPosten är en pekare, inte innehåll. Varje tjänst publicerar sin tillämpning som en profil av denna profil, i\ntjänstens IG, och bestämmer där om informationsmängder och tidpunkt för senaste ändring är obligatoriska." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "DocumentReference"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/DocumentReference/IndexpostFranAdapter> ;
         fhir:reference [ fhir:v "DocumentReference/IndexpostFranAdapter" ]
       ] ;
       fhir:name [ fhir:v "Indexpost speglad av övergångsadaptern" ] ;
       fhir:description [ fhir:v "Adaptern har slagit ihop dagens engagemangsposter för samma patient, logiska adress och tjänstedomän till en indexpost, med dagens kategori som informationsmängd. Endpointen är tjänsteplattformens endpoint för tjänstekontraktet, enligt adapterns adressregister, och den logiska adressen anges separat. Registrerande producent är adaptern, och källsystemet behålls." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "SubscriptionTopic"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/SubscriptionTopic/indexpost-andrad> ;
         fhir:reference [ fhir:v "SubscriptionTopic/indexpost-andrad" ]
       ] ;
       fhir:name [ fhir:v "Indexpost ändrad" ] ;
       fhir:description [ fhir:v "Triggar när en indexpost skapas, uppdateras eller avregistreras. Avregistrering är en uppdatering till status superseded eller entered-in-error, inte en radering." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "DocumentReference"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/DocumentReference/IndexpostIndragen> ;
         fhir:reference [ fhir:v "DocumentReference/IndexpostIndragen" ]
       ] ;
       fhir:name [ fhir:v "Indragen indexpost" ] ;
       fhir:description [ fhir:v "Producenten har dragit tillbaka posten eftersom engagemanget är avslutat. Posten ligger kvar som gravsten under gravstenarnas lagringstid och syns vid avstämning och export, men inte i en standardsökning." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/ContentLastUpdated> ;
         fhir:reference [ fhir:v "StructureDefinition/ContentLastUpdated" ]
       ] ;
       fhir:name [ fhir:v "Innehållets senaste ändring" ] ;
       fhir:description [ fhir:v "När det kliniska innehållet i källsystemet senast ändrades, enligt producenten. Gäller hela posten. Hålls isär från meta.lastUpdated, som anger när indexposten ändrades i FHIR-EI. Motsvarar mostRecentContent i dagens engagemangsindex." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/ValueSet/IneraEngagementCategoryValueSet> ;
         fhir:reference [ fhir:v "ValueSet/IneraEngagementCategoryValueSet" ]
       ] ;
       fhir:name [ fhir:v "Kategorier inom tjänstedomän" ] ;
       fhir:description [ fhir:v "Alla kategorier i kodverket för kategorier inom tjänstedomän." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CodeSystem/IneraEngagementCategoryCodeSystem> ;
         fhir:reference [ fhir:v "CodeSystem/IneraEngagementCategoryCodeSystem" ]
       ] ;
       fhir:name [ fhir:v "Kodsystem för kategorier inom tjänstedomän" ] ;
       fhir:description [ fhir:v "Kategorier inom en tjänstedomän, som anger informationsmängd i FHIR-EI under övergången till profil-canonicals. Motsvarar categorization i dagens engagemangsindex. Utdrag; den fullständiga förteckningen förvaltas tillsammans med tjänstedomänerna." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CodeSystem/IneraDeregistrationReasonCodeSystem> ;
         fhir:reference [ fhir:v "CodeSystem/IneraDeregistrationReasonCodeSystem" ]
       ] ;
       fhir:name [ fhir:v "Kodsystem för orsaker till avregistrering" ] ;
       fhir:description [ fhir:v "Varför en indexpost avregistreras. Orsaken avgör hur mottagare, till exempel ett tunt index, ska hantera avregistreringen." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CodeSystem/IneraIndexRegistrationStatusCodeSystem> ;
         fhir:reference [ fhir:v "CodeSystem/IneraIndexRegistrationStatusCodeSystem" ]
       ] ;
       fhir:name [ fhir:v "Kodsystem för registreringsstatus" ] ;
       fhir:description [ fhir:v "En indexposts livscykeltillstånd. Varje kod motsvarar ett värde i DocumentReference.status." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/CodeSystem/IneraServiceDomainCodeSystem> ;
         fhir:reference [ fhir:v "CodeSystem/IneraServiceDomainCodeSystem" ]
       ] ;
       fhir:name [ fhir:v "Kodsystem för tjänstedomäner" ] ;
       fhir:description [ fhir:v "Tjänstedomäner, som anger tjänst i FHIR-EI under övergången till IG-canonicals. Utdrag; den fullständiga förteckningen förvaltas i Ineras förteckning över tjänstedomäner." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/SourceSystem> ;
         fhir:reference [ fhir:v "StructureDefinition/SourceSystem" ]
       ] ;
       fhir:name [ fhir:v "Källsystem" ] ;
       fhir:description [ fhir:v "Källsystemet enligt dagens engagemangsindex, som HSA-id. Sätts av övergångsadaptern, eftersom registrerande producent då är adaptern och inte källsystemet. En post kan ha flera källsystem när adaptern slår ihop engagemangsposter. Motsvarar sourceSystem i dagens engagemangsindex." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/LogicalAddress> ;
         fhir:reference [ fhir:v "StructureDefinition/LogicalAddress" ]
       ] ;
       fhir:name [ fhir:v "Logisk adress" ] ;
       fhir:description [ fhir:v "Den logiska adress som konsumenten anger när den hämtar informationen via tjänsteplattformen, som HSA-id. Krävs när endpointen adresseras med logisk adress, som för RIV-TA-källor; annars utelämnas den. I tjänstekatalogen är den logiska adressen en organisations HSA-id. Motsvarar logicalAddress i dagens engagemangsindex." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/DeregistrationReason> ;
         fhir:reference [ fhir:v "StructureDefinition/DeregistrationReason" ]
       ] ;
       fhir:name [ fhir:v "Orsak till avregistrering" ] ;
       fhir:description [ fhir:v "Varför posten avregistrerades: felregistrering, avslutat engagemang, gallring eller avregistrering via övergångsadaptern. Finns om och endast om posten inte är registrerad." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/ValueSet/IneraDeregistrationReasonValueSet> ;
         fhir:reference [ fhir:v "ValueSet/IneraDeregistrationReasonValueSet" ]
       ] ;
       fhir:name [ fhir:v "Orsaker till avregistrering" ] ;
       fhir:description [ fhir:v "Alla orsaker till avregistrering av en indexpost." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Subscription"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/Subscription/PrenumerationForPatient> ;
         fhir:reference [ fhir:v "Subscription/PrenumerationForPatient" ]
       ] ;
       fhir:name [ fhir:v "Prenumeration på en patients indexposter" ] ;
       fhir:description [ fhir:v "En konsument prenumererar på ändrade indexposter för en patient inom en tjänst." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexSubscription"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexSubscription>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexSubscription> ;
         fhir:reference [ fhir:v "StructureDefinition/IneraIndexSubscription" ]
       ] ;
       fhir:name [ fhir:v "Prenumeration på indexposter (FHIR-EI)" ] ;
       fhir:description [ fhir:v "En konsuments prenumeration på ändrade indexposter, på topic `indexpost-andrad`. Prenumerationen kan\nfiltreras på patient, tjänst och vårdgivare. Notiser bär bara id för ändrade poster, så att de inte bär\nmer patientinformation än nödvändigt." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/SourceEndpoint> ;
         fhir:reference [ fhir:v "StructureDefinition/SourceEndpoint" ]
       ] ;
       fhir:name [ fhir:v "Producentens endpoint" ] ;
       fhir:description [ fhir:v "Producentens åtkomstpunkt, som Endpoint-resurs i tjänstekatalogen. Katalogen är auktoritativ för endpointens egenskaper. Exakt en per indexpost. Motsvarar logicalAddress i dagens engagemangsindex." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "DocumentReference"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/DocumentReference/IndexpostFhirProducent> ;
         fhir:reference [ fhir:v "DocumentReference/IndexpostFhirProducent" ]
       ] ;
       fhir:name [ fhir:v "Registrerad indexpost från en FHIR-producent" ] ;
       fhir:description [ fhir:v "Journalsystem A har vård- och omsorgsdokumentation om patienten. Tjänsten anges med både tjänstedomän och IG-canonical, och informationsmängden med både kategori och profil-canonical." ] ;
       fhir:isExample [ fhir:v true ] ;
       fhir:profile ( [
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"^^xsd:anyURI ;
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry>
       ] )
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/StructureDefinition/RegisteringProducer> ;
         fhir:reference [ fhir:v "StructureDefinition/RegisteringProducer" ]
       ] ;
       fhir:name [ fhir:v "Registrerande producent" ] ;
       fhir:description [ fhir:v "Producentens identitet: den Endpoint i tjänstekatalogen som den autentiserade klienten är bunden till, som absolut referens. För en direktansluten producent är det samma endpoint som i sourceEndpoint. Referensen är också producentens namnrymd i identifier.system. FHIR-EI kontrollerar värdet mot den autentiserade klienten. Får inte ändras på en befintlig post. Motsvarar owner i dagens engagemangsindex." ] ;
       fhir:isExample [ fhir:v false ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:link <https://fhir.inera.se/ig/engagementindex/Bundle/RegistreringTransaction> ;
         fhir:reference [ fhir:v "Bundle/RegistreringTransaction" ]
       ] ;
       fhir:name [ fhir:v "Registrering och avregistrering i en transaction" ] ;
       fhir:description [ fhir:v "En producent registrerar en post och avregistrerar en felregistrerad post i samma transaction. Bundlen registreras helt eller inte alls." ] ;
       fhir:isExample [ fhir:v true ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
           fhir:v "StructureDefinition:extension"
         ]
       ] ) ;
