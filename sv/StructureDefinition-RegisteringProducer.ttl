  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Extension" ] ;
       fhir:path [ fhir:v "Extension" ] ;
       fhir:short [ fhir:v "Registrerande producent" ] ;
       fhir:definition [ fhir:v "Producentens identitet: den Endpoint i tjänstekatalogen som den autentiserade klienten är bunden till, som absolut referens. För en direktansluten producent är det samma endpoint som i sourceEndpoint. Referensen är också producentens namnrymd i identifier.system. FHIR-EI kontrollerar värdet mot den autentiserade klienten. Får inte ändras på en befintlig post. Motsvarar owner i dagens engagemangsindex." ]
     ] [
       fhir:id [ fhir:v "Extension.extension" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.url" ] ;
       fhir:path [ fhir:v "Extension.url" ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/RegisteringProducer"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x]" ] ;
       fhir:path [ fhir:v "Extension.value[x]" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Endpoint"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Endpoint>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "Extension.value[x].reference" ] ;
       fhir:path [ fhir:v "Extension.value[x].reference" ] ;
       fhir:short [ fhir:v "Absolut URL till producentens Endpoint i tjänstekatalogen" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] )
  ] . # 

