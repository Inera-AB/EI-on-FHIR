        <name value="source-endpoint"/>
        <definition value="https://fhir.inera.se/ig/engagementindex/SearchParameter/DocumentReference-source-endpoint"/>
        <type value="reference"/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
