        <type value="token"/>
        <documentation value="Standardvärde current. Avregistrerade poster returneras bara när status anges explicit."/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="custodian"/>
        <definition value="http://hl7.org/fhir/SearchParameter/DocumentReference-custodian"/>
        <type value="reference"/>
        <documentation value="Vårdgivare, med modifieraren :identifier och HSA-id."/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="identifier"/>
        <definition value="http://hl7.org/fhir/SearchParameter/clinical-identifier"/>
        <type value="token"/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="format-code"/>
        <definition value="http://hl7.org/fhir/SearchParameter/DocumentReference-format-code"/>
        <type value="token"/>
        <documentation value="Informationsmängd som kategori (content.profile som Coding)."/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="format-canonical"/>
