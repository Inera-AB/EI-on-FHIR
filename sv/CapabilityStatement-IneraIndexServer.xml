  <implementationGuide value="https://fhir.inera.se/ig/engagementindex/ImplementationGuide/inera.ei.engagementindex"/>
  <rest>
    <mode value="server"/>
    <documentation value="Alla läs-, skriv-, prenumerations- och exportanrop går genom samma centrala kontroll av behörighet, spärr och loggning. Se sidan Spärr, loggning och behörighet."/>
    <security>
      <description value="Se sidan Spärr, loggning och behörighet."/>
    </security>
    <resource>
      <type value="DocumentReference"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"/>
      <documentation value="Indexposter. En producent får bara skapa, uppdatera och avregistrera poster som tillhör dess registrerade identitet. Avregistrering sker med villkorad uppdatering, aldrig med delete. En sökning utan status-parameter returnerar bara poster med status current."/>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="read"/>
      </interaction>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="vread"/>
      </interaction>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="update"/>
        <documentation value="Villkorad uppdatering på identifier: PUT DocumentReference?identifier=system|value."/>
      </interaction>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="history-instance"/>
      </interaction>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="search-type"/>
      </interaction>
      <versioning value="versioned"/>
      <readHistory value="true"/>
      <updateCreate value="true"/>
      <conditionalCreate value="false"/>
      <conditionalUpdate value="true"/>
      <conditionalDelete value="not-supported"/>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="patient"/>
        <definition value="http://hl7.org/fhir/SearchParameter/clinical-patient"/>
        <type value="reference"/>
        <documentation value="Med modifieraren :identifier, t.ex. patient:identifier=http://electronichealth.se/identifier/personnummer|191212121212."/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="type"/>
        <definition value="http://hl7.org/fhir/SearchParameter/clinical-type"/>
