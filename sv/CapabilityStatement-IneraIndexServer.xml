        <definition value="http://hl7.org/fhir/SearchParameter/Resource-lastUpdated"/>
        <type value="date"/>
        <documentation value="Inkrementell avstämning, tillsammans med status=current,superseded,entered-in-error."/>
      </searchParam>
    </resource>
    <resource>
      <type value="Subscription"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexSubscription"/>
