       fhir:definition [ fhir:v "Time period during which identifier is/was valid for use." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Identifier.period" ] ;
