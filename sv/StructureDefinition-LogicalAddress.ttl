  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Extension" ] ;
       fhir:path [ fhir:v "Extension" ] ;
       fhir:short [ fhir:v "Logisk adress" ] ;
       fhir:definition [ fhir:v "Den logiska adress som konsumenten anger när den hämtar informationen via tjänsteplattformen, som HSA-id. Krävs när endpointen adresseras med logisk adress, som för RIV-TA-källor; annars utelämnas den. I tjänstekatalogen är den logiska adressen en organisations HSA-id. Motsvarar logicalAddress i dagens engagemangsindex." ]
     ] [
       fhir:id [ fhir:v "Extension.extension" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.url" ] ;
       fhir:path [ fhir:v "Extension.url" ] ;
       fhir:fixed [
         a fhir:uri ;
         fhir:v "https://fhir.inera.se/ig/engagementindex/StructureDefinition/LogicalAddress"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x]" ] ;
       fhir:path [ fhir:v "Extension.value[x]" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Identifier"^^xsd:anyURI ]
       ] )
     ] [
       fhir:id [ fhir:v "Extension.value[x].system" ] ;
       fhir:path [ fhir:v "Extension.value[x].system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:pattern [
         a fhir:uri ;
         fhir:v "urn:oid:1.2.752.29.4.19"^^xsd:anyURI
       ]
     ] [
       fhir:id [ fhir:v "Extension.value[x].value" ] ;
       fhir:path [ fhir:v "Extension.value[x].value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] )
  ] . # 

