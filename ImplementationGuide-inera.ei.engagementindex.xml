        <reference value="CapabilityStatement/IneraIndexServer"/>
      </reference>
      <name value="FHIR-EI server"/>
      <description value="Krav på FHIR-EI som server: sökning, registrering och avregistrering, prenumeration, inkrementell avstämning och massuttag av indexposter."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:resource"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/IneraIndexEntry"/>
      </reference>
      <name value="Indexpost (FHIR-EI)"/>
      <description value="Gemensam indexpost. Anger att en producent via en endpoint har information om en patient inom en tjänst.&#xA;Det finns en post per patient × endpoint × tjänst. Posten kan bära flera informationsmängder, och tidpunkten&#xA;för senaste ändring av innehållet gäller hela posten.&#xA;&#xA;Posten är en pekare, inte innehåll. Varje tjänst publicerar sin tillämpning som en profil av denna profil, i&#xA;tjänstens IG, och bestämmer där om informationsmängder och tidpunkt för senaste ändring är obligatoriska."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="DocumentReference"/>
      </extension>
      <reference>
        <reference value="DocumentReference/IndexpostEjForPatient"/>
      </reference>
      <name value="Indexpost som inte visas för patient eller närstående"/>
      <description value="Producenten har märkt posten med säkerhetsetiketten NOPAT. FHIR-EI lämnar inte ut den vid patientens direktåtkomst eller till ombud och vårdnadshavare, men vid sammanhållen journalföring prövas den som vanligt."/>
      <isExample value="true"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="DocumentReference"/>
      </extension>
      <reference>
        <reference value="DocumentReference/IndexpostFranAdapter"/>
      </reference>
      <name value="Indexpost speglad av övergångsadaptern"/>
      <description value="Adaptern har slagit ihop dagens engagemangsposter för samma patient, logiska adress och tjänstedomän till en indexpost, med dagens kategori som informationsmängd. Endpointen är tjänsteplattformens endpoint för tjänstekontraktet, enligt adapterns adressregister, och den logiska adressen anges separat. Registrerande producent är adaptern, och källsystemet behålls."/>
      <isExample value="true"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="SubscriptionTopic"/>
      </extension>
      <reference>
        <reference value="SubscriptionTopic/indexpost-andrad"/>
      </reference>
      <name value="Indexpost ändrad"/>
      <description value="Triggar när en indexpost skapas, uppdateras eller avregistreras. Avregistrering är en uppdatering till status superseded eller entered-in-error, inte en radering."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="DocumentReference"/>
      </extension>
      <reference>
        <reference value="DocumentReference/IndexpostIndragen"/>
      </reference>
      <name value="Indragen indexpost"/>
      <description value="Producenten har dragit tillbaka posten eftersom engagemanget är avslutat. Posten ligger kvar som gravsten under gravstenarnas lagringstid och syns vid avstämning och export, men inte i en standardsökning."/>
      <isExample value="true"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/ContentLastUpdated"/>
      </reference>
      <name value="Innehållets senaste ändring"/>
      <description value="När det kliniska innehållet i källsystemet senast ändrades, enligt producenten. Gäller hela posten. Hålls isär från meta.lastUpdated, som anger när indexposten ändrades i FHIR-EI. Motsvarar mostRecentContent i dagens engagemangsindex."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ValueSet"/>
      </extension>
      <reference>
        <reference value="ValueSet/IneraEngagementCategoryValueSet"/>
      </reference>
      <name value="Kategorier inom tjänstedomän"/>
      <description value="Alla kategorier i kodverket för kategorier inom tjänstedomän."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="CodeSystem"/>
      </extension>
      <reference>
        <reference value="CodeSystem/IneraEngagementCategoryCodeSystem"/>
      </reference>
      <name value="Kodsystem för kategorier inom tjänstedomän"/>
      <description value="Kategorier inom en tjänstedomän, som anger informationsmängd i FHIR-EI under övergången till profil-canonicals. Motsvarar categorization i dagens engagemangsindex. Utdrag; den fullständiga förteckningen förvaltas tillsammans med tjänstedomänerna."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="CodeSystem"/>
      </extension>
      <reference>
        <reference value="CodeSystem/IneraDeregistrationReasonCodeSystem"/>
      </reference>
      <name value="Kodsystem för orsaker till avregistrering"/>
      <description value="Varför en indexpost avregistreras. Orsaken avgör hur mottagare, till exempel ett tunt index, ska hantera avregistreringen."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="CodeSystem"/>
      </extension>
      <reference>
        <reference value="CodeSystem/IneraIndexRegistrationStatusCodeSystem"/>
      </reference>
      <name value="Kodsystem för registreringsstatus"/>
      <description value="En indexposts livscykeltillstånd. Varje kod motsvarar ett värde i DocumentReference.status."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="CodeSystem"/>
      </extension>
      <reference>
        <reference value="CodeSystem/IneraServiceDomainCodeSystem"/>
      </reference>
      <name value="Kodsystem för tjänstedomäner"/>
      <description value="Tjänstedomäner, som anger tjänst i FHIR-EI under övergången till IG-canonicals. Utdrag; den fullständiga förteckningen förvaltas i Ineras förteckning över tjänstedomäner."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/SourceSystem"/>
      </reference>
      <name value="Källsystem"/>
      <description value="Källsystemet enligt dagens engagemangsindex, som HSA-id. Sätts av övergångsadaptern, eftersom registrerande producent då är adaptern och inte källsystemet. En post kan ha flera källsystem när adaptern slår ihop engagemangsposter. Motsvarar sourceSystem i dagens engagemangsindex."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/LogicalAddress"/>
      </reference>
      <name value="Logisk adress"/>
      <description value="Den logiska adress som konsumenten anger när den hämtar informationen via tjänsteplattformen, som HSA-id. Krävs när endpointen adresseras med logisk adress, som för RIV-TA-källor; annars utelämnas den. I tjänstekatalogen är den logiska adressen en organisations HSA-id. Motsvarar logicalAddress i dagens engagemangsindex."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/DeregistrationReason"/>
      </reference>
      <name value="Orsak till avregistrering"/>
      <description value="Varför posten avregistrerades: felregistrering, avslutat engagemang, gallring eller avregistrering via övergångsadaptern. Finns om och endast om posten inte är registrerad."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ValueSet"/>
      </extension>
      <reference>
        <reference value="ValueSet/IneraDeregistrationReasonValueSet"/>
      </reference>
      <name value="Orsaker till avregistrering"/>
      <description value="Alla orsaker till avregistrering av en indexpost."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Subscription"/>
      </extension>
      <reference>
        <reference value="Subscription/PrenumerationForPatient"/>
      </reference>
      <name value="Prenumeration på en patients indexposter"/>
      <description value="En konsument prenumererar på ändrade indexposter för en patient inom en tjänst."/>
      <isExample value="true"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexSubscription"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:resource"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/IneraIndexSubscription"/>
      </reference>
      <name value="Prenumeration på indexposter (FHIR-EI)"/>
      <description value="En konsuments prenumeration på ändrade indexposter, på topic `indexpost-andrad`. Prenumerationen kan&#xA;filtreras på patient, tjänst och vårdgivare. Notiser bär bara id för ändrade poster, så att de inte bär&#xA;mer patientinformation än nödvändigt."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/SourceEndpoint"/>
      </reference>
      <name value="Producentens endpoint"/>
      <description value="Producentens åtkomstpunkt, som Endpoint-resurs i tjänstekatalogen. Katalogen är auktoritativ för endpointens egenskaper. Exakt en per indexpost. Motsvarar logicalAddress i dagens engagemangsindex."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="DocumentReference"/>
      </extension>
      <reference>
        <reference value="DocumentReference/IndexpostFhirProducent"/>
      </reference>
      <name value="Registrerad indexpost från en FHIR-producent"/>
      <description value="Journalsystem A har vård- och omsorgsdokumentation om patienten. Tjänsten anges med både tjänstedomän och IG-canonical, och informationsmängden med både kategori och profil-canonical."/>
      <isExample value="true"/>
      <profile value="https://fhir.inera.se/ig/engagementindex/StructureDefinition/IneraIndexEntry"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/RegisteringProducer"/>
      </reference>
      <name value="Registrerande producent"/>
      <description value="Producentens identitet: den Endpoint i tjänstekatalogen som den autentiserade klienten är bunden till, som absolut referens. För en direktansluten producent är det samma endpoint som i sourceEndpoint. Referensen är också producentens namnrymd i identifier.system. FHIR-EI kontrollerar värdet mot den autentiserade klienten. Får inte ändras på en befintlig post. Motsvarar owner i dagens engagemangsindex."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="Bundle"/>
      </extension>
      <reference>
        <reference value="Bundle/RegistreringTransaction"/>
      </reference>
      <name value="Registrering och avregistrering i en transaction"/>
      <description value="En producent registrerar en post och avregistrerar en felregistrerad post i samma transaction. Bundlen registreras helt eller inte alls."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="StructureDefinition:extension"/>
      </extension>
      <reference>
        <reference value="StructureDefinition/RegistrationStatus"/>
      </reference>
      <name value="Registreringsstatus"/>
      <description value="Postens exakta livscykeltillstånd: registrerad, indragen eller felregistrerad. Bär den semantik som DocumentReference.status inte kan uttrycka, eftersom basbindningen inte kan utökas."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ValueSet"/>
      </extension>
      <reference>
        <reference value="ValueSet/IneraIndexRegistrationStatusValueSet"/>
      </reference>
      <name value="Registreringsstatus för indexposter"/>
      <description value="Alla livscykeltillstånd för en indexpost."/>
      <isExample value="false"/>
    </resource>
    <resource>
