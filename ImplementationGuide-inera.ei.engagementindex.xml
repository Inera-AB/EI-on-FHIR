        <valueString value="SearchParameter"/>
      </extension>
      <reference>
        <reference value="SearchParameter/DocumentReference-source-endpoint"/>
      </reference>
      <name value="Sök på producentens endpoint"/>
      <description value="Producentens endpoint i tjänstekatalogen (extension sourceEndpoint)."/>
      <isExample value="false"/>
    </resource>
    <resource>
