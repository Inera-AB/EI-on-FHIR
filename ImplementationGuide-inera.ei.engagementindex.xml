      <reference>
        <reference value="Bundle/SokresultatForPatient"/>
      </reference>
      <name value="Sökresultat för en patient"/>
      <description value="Svar på en konsuments sökning efter en patients indexposter. Utan status-parameter returneras bara registrerade poster, så den indragna posten finns inte med."/>
      <isExample value="true"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
        <valueString value="ValueSet"/>
      </extension>
      <reference>
        <reference value="ValueSet/IneraServiceDomainValueSet"/>
      </reference>
      <name value="Tjänstedomäner"/>
      <description value="Alla tjänstedomäner i Ineras kodverk för tjänstedomäner."/>
      <isExample value="false"/>
    </resource>
    <resource>
      <extension url="http://hl7.org/fhir/tools/StructureDefinition/resource-information">
