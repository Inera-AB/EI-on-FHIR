        <valueString value="SearchParameter"/>
      </extension>
      <reference>
        <reference value="SearchParameter/DocumentReference-content-last-updated"/>
      </reference>
      <name value="Sök på innehållets senaste ändring"/>
      <description value="Filtrerar indexposter på när det kliniska innehållet i källsystemet senast ändrades (extension contentLastUpdated). Ersätter tidsfiltret i FindContent."/>
      <isExample value="false"/>
    </resource>
    <resource>
